<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="EJERCICIO EN CLASE"/>
        <attribute name="authors" value="Lab Programacion"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-09-30 12:25:51 p.&#8239;m."/>
        <attribute name="created" value="TGFiIFByb2dyYW1hY2lvbjtFUVVJUE8tMTE2OzIwMjYtMDktMzA7MTE6MDY6MjkgYS7igK9tLjsxMTg4Mg=="/>
        <attribute name="edited" value="TGFiIFByb2dyYW1hY2lvbjtFUVVJUE8tMTE2OzIwMjYtMDktMzA7MTI6MjU6NTEgcC7igK9tLjs0OzEyMDA1"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <comment text="Step 1. Define Variables "/>
            <declare name="Number1, Number2, Add, Subs, Mult, Div" type="Real" array="False" size=""/>
            <declare name="Opt" type="Integer" array="False" size=""/>
            <comment text="Step 2. Initialize"/>
            <assign variable="Number1" expression="0"/>
            <assign variable="Number2" expression="0"/>
            <assign variable="Add" expression="0"/>
            <assign variable="Subs" expression="0"/>
            <assign variable="Mult" expression="0"/>
            <assign variable="Div" expression="0"/>
            <assign variable="Opt" expression="0"/>
            <comment text="Step 3. Inputs - Get Data "/>
            <assign variable="Number1" expression="Random(100)+1"/>
            <output expression="&quot;Number 1 is: &quot; &amp; Number1" newline="True"/>
            <assign variable="Number2" expression="Random(100)+1"/>
            <output expression="&quot;Number 2 is: &quot; &amp; Number2" newline="True"/>
            <output expression="&quot;Main menu.&quot; &amp; Tochar(13)&amp;&#13;&#10;&quot;[1]. Addition&quot; &amp; Tochar(13)&amp;&#13;&#10;&quot;[2]. Substraction&quot; &amp; Tochar(13)&amp;&#13;&#10;&quot;{3}. Multiplication&quot; &amp; Tochar(13)&amp;&#13;&#10;&quot;[4]. Division&quot; &amp; Tochar(13)&amp;&#13;&#10;&quot;[5]. All operations&quot;" newline="True"/>
            <output expression="&quot;Press any option: &quot;" newline="True"/>
            <input variable="Opt"/>
            <if expression="Opt = 1">
                <then>
                    <assign variable="Add" expression="Number1 + Number2"/>
                    <output expression="&quot;Addition is: &quot; &amp; Add" newline="True"/>
                </then>
                <else>
                    <if expression="Opt = 2">
                        <then>
                            <assign variable="Subs" expression="Number1 - Number2"/>
                            <output expression="&quot;Substraction is: &quot; &amp; Subs" newline="True"/>
                        </then>
                        <else>
                            <if expression="Opt = 3">
                                <then>
                                    <assign variable="Mult" expression="Number1 * Number2"/>
                                    <output expression="&quot; Multiplication is: &quot; &amp; Mult" newline="True"/>
                                </then>
                                <else>
                                    <if expression="Opt = 4">
                                        <then>
                                            <assign variable="Div" expression="Number1 / Number2"/>
                                            <output expression="&quot;Division is: &quot; &amp; Div" newline="True"/>
                                        </then>
                                        <else>
                                            <if expression="Opt = 5">
                                                <then>
                                                    <assign variable="Add" expression="Number1 + Number2"/>
                                                    <assign variable="Subs" expression="Number1 - Number2"/>
                                                    <assign variable="Mult" expression="Number1 * Number2"/>
                                                    <assign variable="Div" expression="Number1 / Number2"/>
                                                    <output expression="&quot;The Operations is: &quot; &amp; ToChar(13) &amp; &#13;&#10;&quot;Addition is: &quot; &amp; Add &amp; ToChar(13) &amp; &#13;&#10;&quot;Substraction is: &quot; &amp; Subs &amp; ToChar(13) &amp;&#13;&#10;&quot;Multiplication is: &quot; &amp; Mult &amp; ToChar(13) &amp;&#13;&#10;&quot;Division is: &quot; &amp; Div" newline="True"/>
                                                </then>
                                                <else>
                                                    <output expression="&quot;Invalid Option. Try again&quot;" newline="True"/>
                                                </else>
                                            </if>
                                        </else>
                                    </if>
                                </else>
                            </if>
                        </else>
                    </if>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
