<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="loop1"/>
        <attribute name="authors" value="Lab Analisis Datos"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-11-12 09:23:44 p.&#160;m."/>
        <attribute name="created" value="TGFiIEFuYWxpc2lzIERhdG9zO0VRVUlQTy0yMjA7MjAyNi0xMC0yNjswMjozNzowNCBwLuKAr20uOzExOTk2"/>
        <attribute name="edited" value="TGFiIEFuYWxpc2lzIERhdG9zO0VRVUlQTy0yMjA7MjAyNi0xMC0yNjswMzozNTo1NiBwLuKAr20uOzI7MTIxMTE="/>
        <attribute name="edited" value="ZGVsbDtKSE9OTlk7MjAyNi0xMS0xMjswOToyMzo0NCBwLsKgbS47MTE7MjY0MQ=="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="i, dice1, dice2, add, pair, odd, equal, lives, totalroll" type="Integer" array="False" size=""/>
            <declare name="key, name" type="String" array="False" size=""/>
            <assign variable="totalroll" expression="0"/>
            <assign variable="name" expression="&quot;&quot;"/>
            <assign variable="lives" expression="5"/>
            <assign variable="pair" expression="0"/>
            <assign variable="odd" expression="0"/>
            <assign variable="equal" expression="0"/>
            <assign variable="i" expression="1"/>
            <output expression="&quot;Please enter your name&quot;" newline="True"/>
            <input variable="name"/>
            <output expression="&quot;how many times would you like to roll dice?&quot;" newline="True"/>
            <input variable="totalroll"/>
            <for variable="i" start="1" end="totalroll" direction="inc" step="1">
                <if expression="lives &gt; 0">
                    <then>
                        <output expression="&quot;please amy key to roll dice&quot;" newline="True"/>
                        <input variable="key"/>
                        <output expression="&quot;Roll # &quot; &amp; i" newline="True"/>
                        <assign variable="dice1" expression="random(6) + 1"/>
                        <assign variable="dice2" expression="random (6) +1"/>
                        <output expression="&quot;Dice 1 : &quot; &amp; dice1" newline="True"/>
                        <output expression="&quot;Dice 2 : &quot; &amp; dice2" newline="True"/>
                        <assign variable="add" expression="dice1 + dice2"/>
                        <output expression="&quot;the add the dices is : &quot; &amp; add" newline="True"/>
                        <if expression="add mod 2 = 0">
                            <then>
                                <assign variable="pair" expression="pair + 1"/>
                                <if expression="dice1 == dice2">
                                    <then>
                                        <assign variable="equal" expression="equal + 1"/>
                                    </then>
                                    <else/>
                                </if>
                                <if expression="lives = 5">
                                    <then>
                                        <output expression="&quot;The lives are completed&quot;" newline="True"/>
                                    </then>
                                    <else>
                                        <assign variable="lives" expression="lives + 1"/>
                                    </else>
                                </if>
                            </then>
                            <else>
                                <assign variable="odd" expression="odd + 1"/>
                                <assign variable="lives" expression="lives - 1"/>
                                <if expression="lives == 0">
                                    <then>
                                        <output expression="&quot;YOU lost the game&quot;" newline="True"/>
                                    </then>
                                    <else/>
                                </if>
                            </else>
                        </if>
                    </then>
                    <else/>
                </if>
            </for>
            <output expression="&quot;You lives are :&quot; &amp; lives" newline="True"/>
            <output expression="&quot;The pair number is: &quot; &amp; pair" newline="True"/>
            <output expression="&quot;The odd number is: &quot; &amp; odd" newline="True"/>
            <output expression="&quot;The equal number is: &quot; &amp; equal" newline="True"/>
        </body>
    </function>
</flowgorithm>
