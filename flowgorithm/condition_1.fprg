    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="num" type="Integer" array="False" size=""/>
            <assign variable="num" expression="0"/>
            <output expression="&quot;Enter number 1: &quot;" newline="True"/>
            <input variable="num"/>
            <if expression="num &gt; 0">
                <then>
                    <output expression="&quot;The number greater than zero&quot;" newline="True"/>
                </then>
                <else>
                    <output expression="&quot;number less than zero&quot;" newline="True"/>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
