Algoritmo Operations_basic
    Definir num1, num2 Como Real
    Definir sum, rest, multi, divi, resi Como Real
    
    Escribir "Ingrese el primer número:"
    Leer num1
    Escribir "Ingrese el segundo número:"
    Leer num2
    
    sum = num1 + num2
    rest = num1 - num2
    multi = num1 * num2
    divi = num1 / num2
    resi = num1 MOD num2
    
    Escribir "Suma: ", sum
    Escribir "Resta: ", rest
    Escribir "Multiplicación: ", multi
    Escribir "División: ", divi
    Escribir "Módulo (residuo): ", resi
FinAlgoritmo
