Algoritmo KmToM
    // Definir variables
    Definir km, m Como Real
    
    // Solicitar los kilómetros al usuario
    Escribir "Ingrese la distancia en kilómetros:"
    Leer km
    
    // Conversión: 1 kilómetro = 1000 metros
    m = km * 1000
    
    // Mostrar resultado
    Escribir "La distancia en metros es: ", m, " m"
FinAlgoritmo
