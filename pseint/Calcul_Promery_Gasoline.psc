Algoritmo Calcul_Promery_Gasoline
	Definir km_car, combus_consum_litres, Promery_combus_consum Como Real
	Escribir "Cuantos kilometros recorrio el carro?"
	Leer km_car
	Escribir "Cuantos litros de combustible consumio el carro?"
	Leer combus_consum_litres
	Promery_combus_consum <- km_car / combus_consum_litres
	Escribir "El promedio de combustible consumido es de " Promery_combus_consum "Km/L"
FinAlgoritmo
