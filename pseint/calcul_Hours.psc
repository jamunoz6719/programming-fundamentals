Algoritmo calcul_Hours
	definir hour, minuts, seconds Como Entero
	Escribir "Ingrese la hora a la cual quieres convertir"
	Leer hour
	minuts <- hour * 60
	seconds <- minuts * 60
	Escribir "en " hour " horas hay ", minuts " minutos" " y en " hour " horas hay ", seconds " segundos" 
FinAlgoritmo
