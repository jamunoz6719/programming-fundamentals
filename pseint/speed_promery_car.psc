Algoritmo speed_promery_car
	Definir dist_traveled, time, speed_promery Como Real
	Escribir "Cuanta distancia recorrio el carro?"
	Leer dist_traveled
	Escribir "Cuanto tiempo recorrio el carro?"
	Leer time
	speed_promery <- time / dist_traveled
	Escribir "la velocidad promedio del carro fue: " speed_promery " KM/H "
	
FinAlgoritmo
