Algoritmo Calcul_Age_Actually
	Definir name Como Caracter
	Definir birthdate Como Real
	Escribir "Digite su nombre"
	Leer name
	Escribir "Dijite su año de nacimiento"
	Leer birthdate
	birthdate <- 2026 - birthdate 
	Escribir "Hola " name ", Actualmente tienes " birthdate " años"
FinAlgoritmo
